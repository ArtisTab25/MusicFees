{
  "name": "musicfees",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/soundfonts.mjs && node scripts/wam.mjs && node scripts/models.mjs && node scripts/legal.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:artifact": "node scripts/build-artifact.mjs",
    "test": "esbuild tests/model.test.ts tests/transcribe.test.ts tests/omr.test.ts --bundle --platform=node --format=esm --outdir=tests --entry-names=_[name] --out-extension:.js=.mjs --external:@coderline/alphatab --log-level=warning && node --test tests/_model.test.mjs tests/_transcribe.test.mjs tests/_omr.test.mjs",
    "predev": "node scripts/wam.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@coderline/alphatab": "1.8.4",
    "@spotify/basic-pitch": "1.0.1",
    "@supabase/supabase-js": "2.118.0",
    "@tensorflow/tfjs-backend-wasm": "3.21.0",
    "@webaudiomodules/sdk": "0.0.12",
    "jspdf": "4.2.1",
    "onnxruntime-web": "1.20.1",
    "pdfjs-dist": "6.4.299",
    "spessasynth_lib": "4.3.14",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@coderline/alphatab-vite": "1.8.4",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "wam-community": "^0.4.9"
  }
}
